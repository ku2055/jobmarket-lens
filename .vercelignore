# CLI source upload allowlist for separate V2 and V2.5 application roots.
*
!frontend
!frontend/**
frontend/node_modules
frontend/node_modules/**
frontend/dist
frontend/dist/**
frontend/playwright-report
frontend/playwright-report/**
frontend/test-results
frontend/test-results/**
frontend/.vercel
frontend/.vercel/**
frontend/.env
frontend/.env.*

!node25
!node25/**
node25/node_modules
node25/node_modules/**
node25/dist
node25/dist/**
node25/.env*
node25/.vercel
node25/.vercel/**
node25/test-results
node25/test-results/**
node25/playwright-report
node25/playwright-report/**

node25/**/.env*
